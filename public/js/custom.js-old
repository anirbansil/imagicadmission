  $('input[type=radio][name=paid_by]').change(function(){
    var paid_by = $(this).val();
    if(paid_by == 'cheque'){
      $('.cheque_fields').show();
      $('.online_field').hide();
    }else if(paid_by == 'online'){
      $('.online_field').show();
      $('.cheque_fields').hide();
    }else{
      $('.cheque_fields').hide();
      $('.online_field').hide();
    }
  });

