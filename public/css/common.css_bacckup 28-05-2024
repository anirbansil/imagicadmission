/**info**/

.info{

	display: inline-block;

	position: relative;

}

.info i{ color: #aaa; padding: 6px 0; cursor: pointer; }

.info .infotooltip{

	position: absolute;

	left: 30px; top: 0;

	background: #fff;

	border: 1px solid #ddd;

	border-radius: 10px;

	width: 200px;

	z-index: 1;

	font-size: 13px; line-height: 17px;

	padding: 10px;

	transform-origin: center 0;

	display: none;

	transition: 0.5s;

}

.info:hover .infotooltip{

	display: block;

}

.info .infotooltip:before{

	position: absolute;

	left: -20px;

	top: 10px;

	border-left: 10px solid transparent;

	border-right: 10px solid #fff;

	border-top: 10px solid transparent;

	border-bottom: 10px solid transparent;

	content: "";

	z-index:2;

}

.info .infotooltip:after{

	position: absolute;

	left: -22px;

	top: 10px;

	border-left: 11px solid transparent;

	border-right: 11px solid #ccc;

	border-top: 10px solid transparent;

	border-bottom: 11px solid transparent;

	content: "";

	z-index: 1;

}

.info .infotooltip p{ margin: 0; }



